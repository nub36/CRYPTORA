# ============================================================
# CRYPTORA — Environment Variables
# ============================================================
# Copy to .env and fill in values. NEVER commit real secrets.
# ============================================================
#
# ⚠️ NO ADMIN CREDENTIALS IN THIS FILE.
#    There is no ADMIN_PASSWORD / ADMIN_SEED_PASSWORD anywhere.
#    The first admin is created interactively:  npm run create-admin
#    The password is typed at the prompt, hashed with Argon2id and
#    written straight to PostgreSQL — never to .env, a script, git,
#    a migration, or a log.
# ============================================================

# ── Server ────────────────────────────────────────────────────
# Production MUST bind 127.0.0.1 only (Nginx is the public front door).
# Port 3000 is NOT opened in the firewall.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# ── Database (PostgreSQL) ─────────────────────────────────────
DATABASE_URL=postgresql://cryptora:cryptora@127.0.0.1:5432/cryptora

# ── Session (server-side, connect-pg-simple) ──────────────────
# Generate: openssl rand -hex 32
SESSION_SECRET=dev-secret-change-in-production
SESSION_MAX_AGE=604800000
# 'postgres' is the only production-legal value.
# 'memory' exists solely for the test suite; createApp() throws if it is
# requested while NODE_ENV=production, so production can never silently
# fall back to an in-memory store.
SESSION_STORE=postgres

# ── Cookie ────────────────────────────────────────────────────
# Production: COOKIE_SECURE=true (HTTPS required)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── Registration ──────────────────────────────────────────────
# Set to false to close public registration.
REGISTRATION_ENABLED=true

# ── Canonical public origin ───────────────────────────────────
# The ONLY origin accepted by the CSRF middleware in production, and the base
# used to build email verification links (${APP_ORIGIN}/verify-email?token=…).
# Must be the exact scheme + host the browser uses — no trailing slash, no path.
# A plain-http value is rejected in production: only https:// is allowed.
# Local dev: http://localhost:5173
APP_ORIGIN=http://localhost:5173

# ── SMTP (email verification) ─────────────────────────────────
# Provider-agnostic. Any standard SMTP relay works (Brevo, Resend, Postmark…).
# See docs/AUTH_SETUP.md for provider walk-throughs.
# If SMTP_HOST is empty, mail is UNAVAILABLE in production: registration still
# succeeds (the account stays unverified) and resend answers 503 MAIL_UNAVAILABLE.
# Production never silently falls back to a fake transport.
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (usually port 465); false = STARTTLS (usually port 587)
SMTP_SECURE=false
SMTP_USER=
# Leave empty in this file — never commit a real credential.
SMTP_PASS=
# Sender identity (preferred form):
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CRYPTORA
# Legacy combined form, still accepted: CRYPTORA <noreply@example.com>
MAIL_FROM=
# Connection/greeting/socket timeout in ms (default: 10000).
SMTP_TIMEOUT_MS=10000
# 'smtp' | 'json' | empty (auto).
# empty → smtp when SMTP_HOST is set, otherwise 'json' outside production and
# 'unavailable' inside production. 'json' only echoes to stdout; it never sends.
MAIL_TRANSPORT=

# ── Email verification ────────────────────────────────────────
# Legacy link tokens: minutes a verification LINK stays valid (default: 60).
EMAIL_VERIFY_TOKEN_TTL_MINUTES=60
# 6-digit codes: minutes a code stays valid (default: 10).
EMAIL_VERIFY_CODE_TTL_MINUTES=10
# Wrong guesses allowed per code before it burns (default: 5).
EMAIL_VERIFY_CODE_MAX_ATTEMPTS=5
# HMAC key for hashing codes at rest. Generate: openssl rand -hex 32
# Falls back to SESSION_SECRET when empty — set a dedicated value in production.
EMAIL_CODE_HMAC_SECRET=

# ── Social login (OAuth) ──────────────────────────────────────
# All secrets live ONLY here (env) — never in git. A provider with empty
# credentials is simply hidden from the login page; nothing crashes.
# Callback URLs to register with each provider (see docs/AUTH_SETUP.md):
#   https://cryptora.duckdns.org/api/auth/oauth/google/callback
#   https://cryptora.duckdns.org/api/auth/oauth/yandex/callback
#   https://cryptora.duckdns.org/api/auth/oauth/vk/callback
# Google (OIDC): https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Yandex OAuth: https://oauth.yandex.ru/
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# VK ID (id.vk.com, OAuth 2.1 + PKCE): https://id.vk.com/about/business
VK_CLIENT_ID=
VK_CLIENT_SECRET=
# Telegram Login Widget: create a bot via @BotFather, then /setdomain.
# The bot token SIGNS login payloads — treat it like a password.
TELEGRAM_BOT_TOKEN=
# Public bot username WITHOUT @ (embedded in the widget markup).
TELEGRAM_BOT_USERNAME=
# Telegram login payloads older than this are rejected (seconds, default 300).
TELEGRAM_AUTH_MAX_AGE_SECONDS=300
# Outbound timeout for OAuth token/userinfo exchanges (ms, default 10000).
OAUTH_HTTP_TIMEOUT_MS=10000
# Sensitive account actions (link/unlink) require a login newer than this.
FRESH_AUTH_MAX_AGE_MINUTES=30

# ── Rate Limits ───────────────────────────────────────────────
# Per minute per IP, unless noted.
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=5
API_RATE_LIMIT=100

# ── Server Radar monitor ───────────────────────────────────────────────────
# Proposed default operational retention policy pending owner/compliance approval.
# This affects only persisted radar_events, never detector thresholds or math.
# Positive whole days enable bounded cleanup; explicit 0 disables automatic expiry.
RADAR_EVENT_RETENTION_DAYS=30

# Resend-verification: requests per window per IP.
RESEND_RATE_LIMIT=3
RESEND_RATE_WINDOW_MINUTES=15
# Per-email throttle (seconds) — blocks SMTP flooding via one address.
RESEND_MIN_INTERVAL_SECONDS=60
# verify-email / verify-code attempts per window per IP (separate buckets).
VERIFY_RATE_LIMIT=20
VERIFY_RATE_WINDOW_MINUTES=15
# OAuth start/callback requests per 5-minute window per IP.
OAUTH_RATE_LIMIT=30

# ── AI Gateway (server-side only) ─────────────────────────────
# OpenAI API key. Absent → /api/ai/explain returns 503 AI_NOT_CONFIGURED.
OPENAI_API_KEY=
# Model name (default: gpt-4o-mini)
OPENAI_MODEL=
# Gateway port (default: 3100, NOT 3000)
AI_GATEWAY_PORT=3100

# ── AI optional tuning ────────────────────────────────────────
# Request timeout in ms (default: 30000)
AI_REQUEST_TIMEOUT_MS=
# Max output tokens (default: 800)
AI_MAX_OUTPUT_TOKENS=
# Per-IP rate limit: requests per minute (default: 10)
AI_RATE_LIMIT_PER_MIN=
# Max concurrent LLM requests (default: 3)
AI_MAX_CONCURRENCY=
# Max request body bytes (default: 16384)
AI_MAX_BODY_BYTES=
# Cache max entries by facts digest (default: 100)
AI_CACHE_MAX_ENTRIES=

# ── Legacy aliases (still accepted) ───────────────────────────
# AI_API_KEY=    (alias for OPENAI_API_KEY)
# AI_MODEL=      (alias for OPENAI_MODEL)
