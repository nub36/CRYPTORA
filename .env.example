# ============================================================
# CRYPTORA — Environment Variables
# ============================================================
# Copy to .env and fill in values. NEVER commit real secrets.
# ============================================================

# --- AI Gateway (server-side only) ---
# OpenAI API key. Absent → /api/ai/explain returns 503 AI_NOT_CONFIGURED.
OPENAI_API_KEY=
# Model name (default: gpt-4o-mini)
OPENAI_MODEL=
# Gateway port (default: 3100, NOT 3000)
AI_GATEWAY_PORT=3100

# --- AI optional tuning ---
# Request timeout in ms (default: 30000)
AI_REQUEST_TIMEOUT_MS=
# Max output tokens (default: 800)
AI_MAX_OUTPUT_TOKENS=
# Per-IP rate limit: requests per minute (default: 10)
AI_RATE_LIMIT_PER_MIN=
# Max concurrent LLM requests (default: 3)
AI_MAX_CONCURRENCY=
# Max request body bytes (default: 16384)
AI_MAX_BODY_BYTES=
# Cache max entries by facts digest (default: 100)
AI_CACHE_MAX_ENTRIES=

# --- Legacy aliases (still accepted) ---
# AI_API_KEY=    (alias for OPENAI_API_KEY)
# AI_MODEL=      (alias for OPENAI_MODEL)
