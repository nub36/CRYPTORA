# ==============================================================================
# CRYPTORA — Production Environment Configuration Template
# ==============================================================================
# IMPORTANT ARCHITECTURAL INVARIANT:
# CRYPTORA is strictly a Market Intelligence Terminal (Analytics-Only).
# NO trade execution, NO trading bots, NO custody, and NO trading API keys exist.
# DO NOT add private keys, seed phrases, or exchange trading credentials here.
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=3000
NODE_ENV=production

# Public Market Data Proxy (Optional gateway settings)
# Set to 'true' if the VPS provides server-side proxying for public Binance/KuCoin endpoints
MARKET_DATA_PROXY_ENABLED=true
MARKET_DATA_CACHE_TTL_MS=10000

# Client Configuration (Injected during build time via Vite)
# VITE_BINANCE_API_URL=https://api.binance.com
# VITE_KUCOIN_API_URL=https://api.kucoin.com

# AI Analyst (Этап 7) — LLM-объяснение поверх структурированных фактов. Необязательно.
# Без AI_API_KEY эндпоинт /api/ai/explain отвечает 503 {configured:false}, UI использует детерминированные правила.
# Ключ НИКОГДА не попадает в браузер: вызов делает только productionServer.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1   # любой OpenAI-совместимый провайдер
# AI_MODEL=gpt-4o-mini
# AI_TIMEOUT_MS=20000
