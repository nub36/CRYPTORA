# ==============================================================================
# CRYPTORA — Backend Environment Variables
# ==============================================================================
# Copy to .env and fill in real values. NEVER commit .env with secrets.
# ==============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://cryptora:cryptora@127.0.0.1:5432/cryptora

# ── Session ───────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
SESSION_SECRET=dev-secret-change-in-production
SESSION_MAX_AGE=604800000

# ── Cookie ────────────────────────────────────────────────────────────────────
# Production: true (HTTPS required)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── Registration ──────────────────────────────────────────────────────────────
# Set to false to close public registration
REGISTRATION_ENABLED=true

# ── Rate Limits (per minute per IP) ───────────────────────────────────────────
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=5
API_RATE_LIMIT=100