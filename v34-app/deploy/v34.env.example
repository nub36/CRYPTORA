# Конфигурация backend V3.4. Копируется в /etc/v34-app/v34.env, chmod 600, owner root:v34app.
# Здесь НЕТ и не может быть торговых ключей: сервер только читает публичные свечи.

# --- Сеть ---
V34_HOST=127.0.0.1
V34_PORT=8080
# Публичный адрес продукта (для лендинга/ссылок). После настройки домена:
V34_PUBLIC_BASE_URL=https://signals.example.com
# Пусто — CORS выключен; для браузерного лендинга того же origin CORS не нужен.
V34_ALLOWED_ORIGINS=

# --- Данные и БД ---
V34_DB_PATH=/opt/v34app/data/v34.sqlite
V34_STATIC_DIR=/opt/v34app/current/landing
V34_APK_DIR=/opt/v34app/apk
V34_LOG_LEVEL=info

# --- Логика V3.4 (значения по умолчанию = frozen V3.4, не менять без причины) ---
# V34_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,DOGEUSDT
# V34_SCAN_INTERVAL_SECONDS=60
# V34_SCAN_INITIAL_DELAY_MS=5000
# V34_MARKET_TIMEOUT_MS=10000

# --- Push (FCM). Пока конфигурации нет — сервер честно отвечает configured:false ---
V34_PUSH_ENABLED=false
# V34_FCM_PROJECT_ID=your-firebase-project
# V34_FCM_SERVICE_ACCOUNT_FILE=/etc/v34-app/fcm-service-account.json

# --- Прочее ---
V34_MIN_APP_VERSION=0.1.0
