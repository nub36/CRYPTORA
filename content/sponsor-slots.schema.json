{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CRYPTORA sponsor slots",
  "type": "object",
  "required": ["placements"],
  "properties": {
    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "slot", "title", "text", "href", "partner", "activeFrom", "activeTo"],
        "properties": {
          "id": { "type": "string" },
          "slot": { "type": "string", "enum": ["overview-sidebar", "articles-list", "footer-banner"] },
          "title": { "type": "string", "maxLength": 80 },
          "text": { "type": "string", "maxLength": 240 },
          "href": { "type": "string", "pattern": "^https://" },
          "partner": { "type": "string", "maxLength": 60 },
          "activeFrom": { "type": "string", "format": "date" },
          "activeTo": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
