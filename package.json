{
  "name": "cryptora",
  "version": "0.8.49",
  "private": true,
  "type": "module",
  "description": "CRYPTORA — Crypto Market Intelligence Terminal («Рынок. Данные. Решения.»)",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "server": "node server/index.js",
    "articles:index": "node scripts/build-articles-index.mjs",
    "prebuild": "node scripts/build-articles-index.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/productionServer.js",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "migrate": "node scripts/migrate.mjs",
    "migrate:status": "node scripts/migrate.mjs status",
    "create-admin": "node scripts/create-admin.mjs",
    "postinstall": "node scripts/patch-playwright-jsx.cjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "argon2": "^0.45.1",
    "clsx": "^2.1.1",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "lightweight-charts": "^4.2.1",
    "lucide-react": "^0.469.0",
    "nodemailer": "^10.0.10",
    "openai": "^7.17.0",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
